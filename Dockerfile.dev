# syntax=docker/dockerfile:1
# =============================================================================
# Ordeon Web — Dockerfile de DESARROLLO LOCAL
# Multi-stage: COMPILA la SPA React dentro de la imagen.
#
# A diferencia de la version anterior (single-stage que hacia `COPY dist`),
# aqui `docker compose up -d --build` SI refleja los cambios del codigo fuente:
# la imagen compila con `npm run build` en vez de copiar un dist/ precompilado.
# Por eso el comando de siempre ahora refresca el navegador sin pasos extra.
# =============================================================================

# --- Etapa 1: build de la SPA (Node 22 + Vite) ---
FROM node:22-alpine AS build
WORKDIR /app

# Manifiestos + .npmrc primero para aprovechar la cache de capas de Docker.
COPY package.json package-lock.json .npmrc ./

# Token de GitHub Packages: el paquete privado @farutech/design-system lo exige.
# BuildKit secret mount (el token NO queda en el historial de capas de la imagen).
# Compose pasa el secret "npmrc" -> ~/.npmrc del host.
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc npm ci

# Codigo fuente completo.
COPY . .

# API base como build-time (fallback vacio). En runtime se sobreescribe con
# docker-entrypoint.d/99-runtime-env.sh + la variable VITE_API_BASE_URL.
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# --- Etapa 2: runtime Nginx (puerto 80 para el local-gateway) ---
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --chmod=755 docker-entrypoint.d/99-runtime-env.sh /docker-entrypoint.d/99-runtime-env.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/99-runtime-env.sh
RUN sed -i 's/listen 8080;/listen 80;/' /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
